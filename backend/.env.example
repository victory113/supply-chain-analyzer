# Copy to .env and fill in. Never commit the real .env.

# ── Application ────────────────────────────────────────────────────────
ENVIRONMENT=local            # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false               # true in deployed environments

# ── Security ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the dev default.
SECRET_KEY=dev-only-insecure-key-change-me
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
# Production and docker-compose use Postgres (asyncpg driver required):
DATABASE_URL=postgresql+asyncpg://sca:sca@localhost:5432/sca
#
# Local dev with nothing else installed — no Postgres, no Docker. Tables are
# created on startup; Alembic is skipped. Never use this outside local dev.
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Redis / Celery ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Default to REDIS_URL when unset.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CACHE_TTL_SECONDS=900

# ── Anthropic ──────────────────────────────────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4000

# ── Ingestion limits ───────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MAX_ROWS_PER_UPLOAD=50000
